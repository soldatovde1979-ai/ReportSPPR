{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VBA: Import to Excel (Собрать в Workbook.xlsm)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/vba_sync.ps1",
                "-Action", "import"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "VBA: Export from Excel (Выгрузить в src/)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/vba_sync.ps1",
                "-Action", "export"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}